# Copy to .env (repository root) for Docker Compose. Never commit .env.
POSTGRES_USER=diet
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=diet_balancer
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-before-production-use
ENVIRONMENT=development
# Browser origins allowed to call the API
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# URL the browser uses to reach the API (baked into the frontend build)
PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Optional: USDA FoodData Central API key for verified food lookup beyond the built-in catalogue
USDA_API_KEY=
