# Copy to backend/.env and adjust. Never commit the real .env file.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:2205@localhost:5432/diet_balancer
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-before-production-use
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Device timing (seconds)
DEVICE_ONLINE_TIMEOUT_SECONDS=30
COMMAND_PENDING_TTL_SECONDS=60
COMMAND_RESULT_GRACE_SECONDS=90
# Allowed dispense range (grams)
DISPENSE_MIN_G=5
DISPENSE_MAX_G=500
RATE_LIMIT_ENABLED=true
# Advertise the API on your LAN (mDNS) so dispensers find it automatically
MDNS_ENABLED=true
MDNS_PORT=8000
# MDNS_ADVERTISE_IP=192.168.1.20   # set if auto-detection picks the wrong interface
